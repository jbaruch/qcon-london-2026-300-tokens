[0.003, "o", "\u001b]7;file://Mac/Users/jbaruch/Library/CloudStorage/GoogleDrive-jbaruch@sadogursky.com/My%20Drive/Presentations/QCon/London%202026/The%20Right%20300%20Tokens%20Beat%20100k%20Noisy%20Ones%20/demo/service\u001b\\"]
[0.001, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[J\u001b[01;32m➜  \u001b[36mservice\u001b[00m \u001b[K"]
