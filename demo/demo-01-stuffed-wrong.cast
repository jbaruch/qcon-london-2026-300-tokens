[0.039, "o", "\u001b[?2026h\r\u001b[8A\u001b[38;5;65m⏺\r\u001b[2C\u001b[1B\u001b[39m⎿\u001b[1C Added\u001b[1C\u001b[1m11\u001b[1C\u001b[22mlines,\u001b[1Cremoved\u001b[1C\u001b[1m4\u001b[1C\u001b[22mlines\r\u001b[1B \u001b[1C   \u001b[38;2;248;248;242m\u001b[2m 29 \u001b[22m \u001b[39m                                \r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 30 \u001b[22m @router.\u001b[38;2;102;217;239mpost\u001b[38;2;248;248;242m(\u001b[38;2;24;54;145m\"/{\u001b[38;2;102;217;239morder_id\u001b[38;2;24;54;145m}/confirm\"\u001b[38;2;248;248;242m)\r\u001b[1B\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m 31 \u001b[22m \u001b[38;2;249;38;114masync\u001b[38;2;248;248;242m \u001b[38;2;249;38;114mdef\u001b[38;2;248;248;242m \u001b[38;2;121;93;163mconfirm_order\u001b[38;2;248;248;242m(\u001b[38;2;102;217;239morder_id\u001b[38;2;248;248;242m: \u001b[38;2;102;217;239mstr\u001b[38;2;248;248;242m):\u001b[39m                                                   \r\u001b[1B   \u001b[2C\u001b[38;2;249;38;114m\u001b[48;2;61;1;0m 32 -\u001b[38;2;248;248;242m    order = _orders[order_id]  # Raises KeyError if not found - no error handling  \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;249;38;114m\u001b[48;2;61;1;0m 33 -\u001b[38;2;248;248;242m    order.status = \"confirmed\"                                                     \u001b[49m\u001b[39m       \r\u001b[2C\u001b[1B   \u001b[38;2;207"]
