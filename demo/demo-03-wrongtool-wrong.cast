[0.596, "o", "\u001b[?2026h\r\u001b[2C\u001b[5A2.\u001b[1CThe\u001b[1Cv2\u001b[1Cdocs\u001b[1C(using\u001b[1C\u001b[38;5;105mNotifier\u001b[1C\u001b[39m+\u001b[1C\u001b[38;5;105m.send()\u001b[39m)\u001b[1Cscored\u001b[1C\u001b[1m0.767 relevance\u001b[1C\u001b[22mon\u001b[1Cthe\u001b[1Cintegration\u001b[1Cexample.\u001b[1CThe\r\u001b[1B  v3 docs (using \u001b[38;5;105mNotificationClient\u001b[39m + \u001b[38;5;105mMessage\u001b[39m + \u001b[38;5;105m.dispatch()\u001b[39m) scored \u001b[1m0.667\u001b[22m — lower.                  \r\u001b[1B   \r\u001b[2B\u001b[38;5;241m❯ \u001b[39m\u001b[7m \u001b[27m                                                               \r\r\n\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;5;131m⏵⏵\u001b[1Cbypass\u001b[1Cpermissions\u001b[1Con\u001b[38;5;241m (shift+tab\u001b[1Cto\u001b[1Ccycle)\u001b[1C·\u001b[1Cesc\u001b[1Cto\u001b[1Cinterrupt\u001b[39m\r\r\n\u001b[?2026l"]
[0.160, "o", "\u001b]0;⠂ Claude Code\u0007"]
[0.458, "o", "\u001b[?2026h\r\u001b[2C\u001b[5A3.\u001b[1CSo\u001b[1CI\u001b[1Cimplemented\u001b[1Cthe\u001b[1Cv2\u001b[1CAPI.\u001b[1CBecause\u001b[1Cthat's\u001b[1Cwhat\u001b[1Csimilarity-based\u001b[1Csearch\u001b[1Ctold\u001b[1Cme\u001b[1Cwas\u001b[1Cthe\u001b[1Cbest\r\u001b[1B  match. Higher relevance score = more relevant, right?                                             \r\u001b[1B   \r\u001b[2B\u001b[38;5;241m❯ \u001b[39m\u001b[7m \u001b[27m                                                               \r\r\n\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;5;131m⏵⏵\u001b[1Cbypass\u001b[1Cpermissions\u001b[1Con\u001b[38;5;241m (shift+tab\u001b[1Cto\u001b[1Ccycle)\u001b[1C·\u001b[1Cesc\u001b[1Cto\u001b[1Cinterrupt\u001b[39m\r\r\n\u001b[?2026l"]
