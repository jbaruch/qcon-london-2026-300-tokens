[0.428, "o", "\u001b[?2026h\r\u001b[4A  \u001b[1mWrong.\u001b[22m The v2 docs describe an API that no longer exists in the installed library. The installed  \r\u001b[1B  \u001b[38;5;105mpidge\u001b[1C\u001b[39mpackage\u001b[1Cis\u001b[1Cv3,\u001b[1Cwhich\u001b[1Chas\u001b[1Ca\u001b[1Ccompletely\u001b[1Cdifferent\u001b[1Cinterface\u001b[1C—\u001b[1C\u001b[38;5;105mNotificationClient\u001b[39m,\r\u001b[1B  \u001b[38;5;105mNotificationConfig\u001b[39m, \u001b[38;5;105mMessage\u001b[39m, and \u001b[38;5;105m.dispatch()\u001b[39m instead of \u001b[38;5;105mNotifier\u001b[39m, \u001b[38;5;105mNotifierConfig\u001b[39m, and \u001b[38;5;105m.send()\u001b[39m.    \r\u001b[2C\u001b[1B                                                                \r\r\n\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;241m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;5;246m──────────────────────────────────"]
[0.000, "o", "──────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;5;131m⏵⏵\u001b[1Cbypass\u001b[1Cpermissions\u001b[1Con\u001b[38;5;241m (shift+tab\u001b[1Cto\u001b[1Ccycle)\u001b[1C·\u001b[1Cesc\u001b[1Cto\u001b[1Cinterrupt\u001b[39m\r\r\n\u001b[?2026l"]
