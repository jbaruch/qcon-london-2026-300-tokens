[0.387, "o", "\u001b[?2026h\r\u001b[4A  The tests blow up at import time: \u001b[38;5;105m\u001b[1mImportError: cannot import name 'Notifier' from 'pidge'\u001b[22m\u001b[39m.        \r\u001b[1B   \r\u001b[2B\u001b[38;5;241m❯ \u001b[39m\u001b[7m \u001b[27m                                                               \r\r\n\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;5;131m⏵⏵\u001b[1Cbypass\u001b[1Cpermissions\u001b[1Con\u001b[38;5;241m (shift+tab\u001b[1Cto\u001b[1Ccycle)\u001b[1C·\u001b[1Cesc\u001b[1Cto\u001b[1Cinterrupt\u001b[39m\r\r\n\u001b[?2026l"]
[0.576, "o", "\u001b]0;⠂ Claude Code\u0007"]
[0.317, "o", "\u001b[?2026h\r\u001b[4A  The installed version of \u001b[38;5;105mpidge\u001b[39m doesn't have \u001b[38;5;105mNotifier\u001b[39m or \u001b[38;5;105mNotifierConfig\u001b[39m at all. The classes simply \r\u001b[1B  don't\u001b[1Cexist\u001b[1Cin\u001b[1Cthe\u001b[1Cpackage.\r\u001b[1B                                                                                                    \r\u001b[1B\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;241m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;5;131m⏵⏵\u001b[1Cbypass\u001b[1C"]
