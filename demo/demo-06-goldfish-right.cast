[0.025, "o", "\u001b[?2026h\r\u001b[6A\u001b[38;5;231m⏺\u001b[1C\u001b[39mGo with v3 async.                   \r\r\n\r\n\r\n\r\n\r\n\r\n\u001b[?2026l"]
